# CampusPulse Environment Configuration Template
# For production hosting (Vercel, Netlify, Cloudflare Pages)

# Supabase Project Connection (Anonymous / Public Key ONLY)
# NOTICE: NEVER place the service_role secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Application Base URL (e.g., https://campuspulse.vercel.app)
VITE_APP_URL=https://your-production-domain.com

# Prototype Demonstration Flag (Optional override)
VITE_ENABLE_DEMO_MODE=true
